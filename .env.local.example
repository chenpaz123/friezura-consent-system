# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by server-side API routes (never exposed to the browser).
# Supabase project settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 4-digit PIN admins enter to exit "Manual Entry" mode back to the dashboard.
NEXT_PUBLIC_ADMIN_EXIT_PIN=1234
