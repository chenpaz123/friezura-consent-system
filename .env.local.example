# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by server-side API routes and Server Actions (never exposed to
# the browser). Required for the super-admin "delete entry" action, which
# bypasses RLS on purpose. Supabase project settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Staff PINs for the /admin dashboard. Deliberately NOT prefixed with
# NEXT_PUBLIC_ — that keeps them out of the client-side JS bundle entirely;
# they're only ever compared server-side, in src/app/actions/verifyPin.ts.
# Pick your own real values here and in Vercel; don't reuse example digits.
ADMIN_PIN=choose-a-4-digit-staff-pin
# Also unlocks /admin, but marks the session super-admin (surfaces the
# "delete entry" action on a consent's detail view). Not shown in the UI.
SUPER_ADMIN_PIN=choose-a-different-4-digit-pin
